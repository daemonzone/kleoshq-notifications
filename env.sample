# Database connection (Neon PostgreSQL) — same database as the other services.
# Needs INSERT/UPDATE/SELECT on email_log only (migration 0034).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Shared secret every request to /api/send must carry as "Authorization: Bearer …".
# Callers (public-www, the admin app) hold the same value. Generate with: openssl rand -hex 32
NOTIFICATIONS_INTERNAL_SECRET=change-me

# Resend. Either of the first two empty = dry-run (logs + email_log row with outcome 'dry-run').
#   RESEND_API_KEY:        Resend dashboard > API Keys
#   EMAIL_FROM:            a sender on a domain verified in Resend (SPF + DKIM),
#                          e.g. "SiteWitness <noreply@sitewitness.app>"
#   RESEND_WEBHOOK_SECRET: Resend dashboard > Webhooks > (this endpoint /api/webhooks/resend) > Signing secret (whsec_…)
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Optional: where replies go (Reply-To header).
REPLY_TO=
